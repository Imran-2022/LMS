{
  "kind": "collectionType",
  "collectionName": "quizzes",
  "info": {
    "singularName": "quiz",
    "pluralName": "quizzes",
    "displayName": "Quiz",
    "description": "A multiple-choice quiz attached to a course. Correct answers live here and are removed from student-facing responses by the controller."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 160
    },
    "description": {
      "type": "text",
      "maxLength": 500
    },
    "passingScore": {
      "type": "integer",
      "default": 70,
      "min": 0,
      "max": 100,
      "description": "Percentage needed to pass. Compared against the server-computed score."
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "quizzes"
    },
    "questions": {
      "type": "component",
      "repeatable": true,
      "component": "quiz.question"
    },
    "attempts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::quiz-attempt.quiz-attempt",
      "mappedBy": "quiz"
    }
  }
}
